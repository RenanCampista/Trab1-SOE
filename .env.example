# vitoria | guarulhos | galeao | custom
REGION=vitoria
# Usado somente com REGION=custom
CUSTOM_NAME=Minha cidade
CUSTOM_LATITUDE=-20.258
CUSTOM_LONGITUDE=-40.286
RADIUS_KM=50

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Sem credenciais: 240 s = 360 consultas/dia em uma area pequena.
# Com conta padrao: 30 s = 2880 consultas/dia. Reserva para retries e testes.
POLL_INTERVAL_SECONDS=240
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""
MAX_POSITION_AGE_SECONDS=90

PROXIMITY_KM=15
LOW_ALTITUDE_M=1000
VERTICAL_RATE_THRESHOLD_MS=8
APPROACH_SAMPLES=3
APPROACH_MAX_GAP_SECONDS=300
APPROACH_MIN_DISTANCE_DROP_KM=0.2
APPROACH_MIN_ALTITUDE_DROP_M=20
ALERT_COOLDOWN_SECONDS=600
DATABASE_PATH=data/alerts.db
CONTROL_DATABASE_PATH=data/control.db
LOG_LEVEL=INFO

# Dashboard: 127.0.0.1 = somente esta máquina (padrão seguro).
# Em uma VM/VPS para apresentação, use 0.0.0.0 e libere somente a porta 8501 no firewall.
DASHBOARD_BIND_ADDRESS=127.0.0.1
